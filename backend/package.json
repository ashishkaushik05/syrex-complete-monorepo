{
  "name": "syrex-new-api-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "rbac:preflight": "bun run scripts/rbac-preflight.ts",
    "prisma:generate": "PRISMA_GENERATE_SKIP_AUTOINSTALL=1 bunx prisma generate --schema ../schema.prisma",
    "db:reset": "PRISMA_GENERATE_SKIP_AUTOINSTALL=1 bunx prisma db push --schema ../schema.prisma --force-reset --accept-data-loss --skip-generate",
    "db:seed": "bun run rbac:preflight && bun run scripts/demo-seed.ts",
    "db:prepare": "bun run db:reset && bun run db:seed",
    "ci:preflight": "bun run typecheck && bun run rbac:preflight"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@trpc/server": "^11.1.2",
    "hono": "^4.9.1",
    "superjson": "^2.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prisma": "6.19.3",
    "typescript": "^6.0.3"
  }
}
