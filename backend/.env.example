NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/syrex
JWT_SECRET=replace-with-at-least-32-characters
SERVICE_PORTAL_JWT_SECRET=replace-with-a-different-32-character-secret
# Used as fallback orgId for field shift/stop creation when x-org-id header is not sent
DEFAULT_ORG_ID=org-syrex-dev

# Comma-separated browser origins permitted to call the API. Required in production.
CORS_ORIGINS=https://admin.example.com,https://service.example.com,https://commerce.example.com

# JSON/tRPC request cap. File uploads use presigned object storage instead.
MAX_REQUEST_BODY_BYTES=1048576

# Private S3-compatible attachment storage (AWS S3, Cloudflare R2, or MinIO)
OBJECT_STORAGE_ENDPOINT=https://example-account.r2.cloudflarestorage.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=syrex-attachments
OBJECT_STORAGE_ACCESS_KEY_ID=replace-me
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-me
OBJECT_STORAGE_FORCE_PATH_STYLE=false
