{
  "timezonePolicy": "UTC_ISO_8601",
  "decimalTransport": "string",
  "pagination": {
    "style": "cursor",
    "defaultLimit": 25,
    "maxLimit": 100,
    "inputShape": {
      "cursor": "string|null|undefined",
      "limit": "number(1..100), default 25"
    }
  },
  "errors": [
    "BAD_REQUEST",
    "CONFLICT",
    "NOT_FOUND",
    "UNAUTHORIZED",
    "FORBIDDEN",
    "INTERNAL"
  ]
}
