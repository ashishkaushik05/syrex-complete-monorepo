// =============================================================================
// Unified Operations Platform — Prisma Schema
// Version: 3.1 | May 2026
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "./backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserType {
  internal
  outlet
}

enum OrderStatus {
  pending_approval
  approved
  partially_dispatched
  fully_dispatched
  rejected
  cancelled
  on_hold
}

enum OrderPriority {
  low
  medium
  high
  critical
}

enum OrderLineStatus {
  pending
  partially_dispatched
  fully_dispatched
}

enum NotificationChannel {
  in_app
  push
  sms
}

enum BillingProfileType {
  company
  warehouse
  outlet
}

enum GoodsReceiptStatus {
  active
  reversed
  replaced
}

enum GoodsReceiptInvoiceStatus {
  issued
  reversed
  replaced
}

enum InventoryMovementType {
  production_receipt
  production_receipt_reversal
}

enum ServiceComplaintStatus {
  raised
  assigned
  visit
  test_result_submitted
  retest_requested
  resolved
  telephonic_closure
  cancelled
}

enum ServiceFormFieldType {
  text
  textarea
  number
  boolean
  select
  multiselect
  date
}

enum ServiceWarrantyDecisionStatus {
  pending
  approved
  rejected
}

enum ServiceComplainantType {
  self
  on_behalf_of
}

enum ServiceResolutionReason {
  tested_ok
  warranty_approved
  warranty_rejected
  telephonic_closure
  cancelled
}

enum ServiceHappyCallingStatus {
  pending
  completed
  skipped
}

enum ServiceFulfillmentRoute {
  warehouse
  outlet
}

enum ServiceMachineClientStatus {
  active
  revoked
}

enum ChargeType {
  percentage
  fixed
}

enum ServiceTestVerdict {
  tested_ok
  warranty_candidate
  failed
  needs_retest
}

enum ServiceAssignmentAction {
  assign
  reassign
}

enum ServiceSerialEventType {
  legacy_dispatch_hydrated
  replacement_serial_assigned
  replacement_order_created
  replacement_delivered
}

enum ServiceSerialEntityType {
  dispatch_line
  service_complaint_line
  sale_order
  dispatch
}

// =============================================================================
// AUTH + ROLES
// =============================================================================

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  phone          String?
  name           String
  passwordHash   String
  userType       UserType
  roleId         String
  isActive       Boolean  @default(true)
  isFieldEnabled Boolean  @default(false)
  managedByRsmId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  role                         Role                       @relation(fields: [roleId], references: [id])
  managedByRsm                 User?                      @relation("UserManagedByRsm", fields: [managedByRsmId], references: [id])
  managedAsis                  User[]                     @relation("UserManagedByRsm")
  serviceComplaintsAsRsm       ServiceComplaint[]         @relation("ServiceComplaintRsm")
  outlet                       Outlet?
  notifications                Notification[]
  auditLogs                    AuditLog[]
  invitationsSent              UserInvitation[]           @relation("InvitedBy")
  invitationsAccepted          UserInvitation[]           @relation("AcceptedUser")
  attachmentsUploaded          Attachment[]                @relation("AttachmentUploadedByUser")
  ordersCreated                SaleOrder[]                @relation("OrderCreatedBy")
  ordersApproved               SaleOrder[]                @relation("OrderApprovedBy")
  ordersHeld                   SaleOrder[]                @relation("OrderHeldBy")
  paymentReversals             OutletPaymentReversal[]    @relation("PaymentReversedBy")
  dispatchesCreated            Dispatch[]
  stockAdjustments             StockAdjustment[]          @relation("StockAdjustedBy")
  goodsReceiptsCreated         GoodsReceipt[]             @relation("GoodsReceiptCreatedBy")
  goodsReceiptsReversed        GoodsReceipt[]             @relation("GoodsReceiptReversedBy")
  inventoryMovements           InventoryMovement[]        @relation("InventoryMovementCreatedBy")
  managedWarehouse             Warehouse?                 @relation("WarehouseManager")
  authSessions                 AuthSession[]
  shifts                       Shift[]
  fieldSyncStatuses            FieldSyncStatus[]
  fieldVisits                  FieldVisit[]               @relation("FieldVisitAgent")
  fieldVisitsAsCustomer        FieldVisit[]               @relation("FieldVisitCustomer")
  fieldStops                   FieldStop[]
  attendance                   DailyAttendance[]
  shiftSchedule                ShiftSchedule?
  serviceComplaintsRaised      ServiceComplaint[]         @relation("ServiceComplaintRaisedByUser")
  serviceAssignmentsAsi        ServiceAssignmentHistory[] @relation("ServiceAssignmentAsi")
  serviceAssignmentsSe         ServiceAssignmentHistory[] @relation("ServiceAssignmentSe")
  serviceAssignmentsBy         ServiceAssignmentHistory[] @relation("ServiceAssignmentBy")
  serviceTestsSubmitted        ServiceTestReport[]        @relation("ServiceTestSubmittedBy")
  serviceActivities            ServiceComplaintActivity[] @relation("ServiceActivityActor")
  serviceWarrantyDecisions     ServiceWarrantyDecision[]  @relation("ServiceWarrantyDecidedBy")
  serviceMachineClientsCreated ServiceMachineClient[]     @relation("ServiceMachineClientCreatedBy")
  serviceFormTemplatesCreated  ServiceFormTemplate[]      @relation("ServiceFormTemplateCreatedBy")
  serviceFormSubmissions       ServiceFormSubmission[]    @relation("ServiceFormSubmittedBy")
  dispatchTimelineEvents       DispatchTimeline[]         @relation("DispatchTimelineActor")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions String[] @default([])
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  users User[]

  @@map("roles")
}

model UserInvitation {
  id             String    @id @default(uuid())
  email          String
  name           String
  role           String
  token          String    @unique
  status         String    @default("pending")
  invitedById    String
  acceptedUserId String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  invitedBy    User  @relation("InvitedBy", fields: [invitedById], references: [id])
  acceptedUser User? @relation("AcceptedUser", fields: [acceptedUserId], references: [id])

  @@index([email, status])
  @@map("user_invitations")
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

// =============================================================================
// OUTLETS
// =============================================================================

model Outlet {
  id                 String   @id @default(uuid())
  outletCode         String   @unique
  userId             String   @unique
  name               String
  ownerName          String
  phone              String
  address            String
  creditLimit        Decimal  @default(0)
  outstandingBalance Decimal  @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  billingProfileId String? @unique

  // Single warehouse that serves this outlet
  warehouseId    String?
  warehouse      Warehouse?      @relation(fields: [warehouseId], references: [id])
  user           User            @relation(fields: [userId], references: [id])
  billingProfile BillingProfile? @relation("OutletBillingProfile", fields: [billingProfileId], references: [id])

  orders                   SaleOrder[]
  invoices                 Invoice[]
  payments                 OutletPayment[]
  paymentReversals         OutletPaymentReversal[]
  serviceSerialsSold       ServiceSerialIndex[]
  serviceWarrantyDecisions ServiceWarrantyDecision[] @relation("ServiceWarrantySourceOutlet")
  serviceWarrantyClaims    ServiceWarrantyDecision[] @relation("ServiceWarrantyClaimingOutlet")
  fieldVisits              FieldVisit[]

  @@map("outlets")
}

// =============================================================================
// CATALOG  —  Brand → Category → Product
// =============================================================================

model Brand {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories Category[]
  images     Image[]    @relation("BrandImages")

  @@map("brands")
}

model Category {
  id          String   @id @default(uuid())
  brandId     String
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand    Brand     @relation(fields: [brandId], references: [id])
  products Product[]
  images   Image[]   @relation("CategoryImages")

  @@unique([brandId, name])
  @@map("categories")
}

model Product {
  id             String   @id @default(uuid())
  categoryId     String
  name           String
  displayName    String?
  sku            String   @unique
  description    String?
  specs          Json?
  warrantyMonths Int
  basePrice      Decimal
  hsnCode        String
  uqc            String
  gstRate        Decimal
  transferValue  Decimal
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category                 Category                  @relation(fields: [categoryId], references: [id])
  images                   Image[]                   @relation("ProductImages")
  orderLines               SaleOrderLine[]
  invoiceLines             InvoiceLine[]
  dispatchLines            DispatchLine[]
  warehouseStocks          WarehouseStock[]
  goodsReceiptLines        GoodsReceiptLine[]
  goodsReceiptInvoiceLines GoodsReceiptInvoiceLine[]
  inventoryMovements       InventoryMovement[]
  stockAdjustments         StockAdjustment[]
  serviceComplaintLines    ServiceComplaintLine[]
  serviceSerialIndexRows   ServiceSerialIndex[]
  demandSnapshots          SkuDemandSnapshot[]

  @@index([categoryId, isActive])
  @@map("products")
}

// One row per image. Exactly one of brandId / categoryId / productId is set.
model Image {
  id        String   @id @default(uuid())
  uri       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  brandId    String?
  categoryId String?
  productId  String?

  brand    Brand?    @relation("BrandImages", fields: [brandId], references: [id])
  category Category? @relation("CategoryImages", fields: [categoryId], references: [id])
  product  Product?  @relation("ProductImages", fields: [productId], references: [id])

  @@index([brandId])
  @@index([categoryId])
  @@index([productId])
  @@map("images")
}

// =============================================================================
// WAREHOUSE + STOCK
// =============================================================================

model Warehouse {
  id               String   @id @default(uuid())
  name             String
  location         String
  address          String?
  managerId        String?  @unique
  billingProfileId String?  @unique
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  manager                  User?                     @relation("WarehouseManager", fields: [managerId], references: [id])
  billingProfile           BillingProfile?           @relation("WarehouseBillingProfile", fields: [billingProfileId], references: [id])
  outlets                  Outlet[]
  stock                    WarehouseStock[]
  receipts                 GoodsReceipt[]
  inventoryMovements       InventoryMovement[]
  adjustments              StockAdjustment[]
  dispatches               Dispatch[]
  serviceSourceOrders      SaleOrder[]               @relation("ServiceSourceWarehouse")
  serviceWarrantyDecisions ServiceWarrantyDecision[]

  @@index([managerId])
  @@map("warehouses")
}

model WarehouseStock {
  id           String   @id @default(uuid())
  warehouseId  String
  productId    String
  currentQty   Int      @default(0)
  reservedQty  Int      @default(0)
  inTransitQty Int      @default(0)
  updatedAt    DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId])
  @@index([productId])
  @@map("warehouse_stocks")
}

model GoodsReceipt {
  id                     String             @id @default(uuid())
  grnNumber              String             @unique
  warehouseId            String
  sourceBillingProfileId String
  externalDocumentNumber String
  dispatchDate           DateTime
  receiptDate            DateTime
  notes                  String?
  status                 GoodsReceiptStatus @default(active)
  idempotencyKey         String             @unique
  createdById            String
  reversedById           String?
  reversedAt             DateTime?
  reversalReason         String?
  replacesId             String?            @unique
  createdAt              DateTime           @default(now())

  warehouse            Warehouse            @relation(fields: [warehouseId], references: [id])
  sourceBillingProfile BillingProfile       @relation("GoodsReceiptSourceProfile", fields: [sourceBillingProfileId], references: [id])
  createdBy            User                 @relation("GoodsReceiptCreatedBy", fields: [createdById], references: [id])
  reversedBy           User?                @relation("GoodsReceiptReversedBy", fields: [reversedById], references: [id])
  replaces             GoodsReceipt?        @relation("GoodsReceiptReplacement", fields: [replacesId], references: [id])
  replacement          GoodsReceipt?        @relation("GoodsReceiptReplacement")
  lines                GoodsReceiptLine[]
  invoice              GoodsReceiptInvoice?
  movements            InventoryMovement[]

  @@index([warehouseId, receiptDate])
  @@index([sourceBillingProfileId, receiptDate])
  @@index([status])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                    String  @id @default(uuid())
  grnId                 String
  productId             String
  qtyReceived           Int
  skuSnapshot           String
  productNameSnapshot   String
  hsnCodeSnapshot       String
  uqcSnapshot           String
  gstRateSnapshot       Decimal
  transferValueSnapshot Decimal
  taxableValue          Decimal

  grn         GoodsReceipt             @relation(fields: [grnId], references: [id])
  product     Product                  @relation(fields: [productId], references: [id])
  invoiceLine GoodsReceiptInvoiceLine?
  movements   InventoryMovement[]

  @@unique([grnId, productId])
  @@map("goods_receipt_lines")
}

model GoodsReceiptInvoice {
  id                         String                    @id @default(uuid())
  invoiceNumber              String                    @unique
  goodsReceiptId             String                    @unique
  invoiceDate                DateTime
  sourceBillingSnapshot      Json
  destinationBillingSnapshot Json
  sellerGstin                String
  buyerGstin                 String
  placeOfSupplyStateCode     String
  taxableTotal               Decimal
  cgstTotal                  Decimal
  sgstTotal                  Decimal
  igstTotal                  Decimal
  grandTotal                 Decimal
  status                     GoodsReceiptInvoiceStatus @default(issued)
  irn                        String?
  acknowledgementNumber      String?
  acknowledgementDate        DateTime?
  signedQrCode               String?
  eWayBillNumber             String?
  eWayBillDate               DateTime?
  eWayBillValidUntil         DateTime?
  replacesId                 String?                   @unique
  createdAt                  DateTime                  @default(now())

  goodsReceipt GoodsReceipt              @relation(fields: [goodsReceiptId], references: [id])
  replaces     GoodsReceiptInvoice?      @relation("GoodsReceiptInvoiceReplacement", fields: [replacesId], references: [id])
  replacement  GoodsReceiptInvoice?      @relation("GoodsReceiptInvoiceReplacement")
  lines        GoodsReceiptInvoiceLine[]

  @@index([sellerGstin, invoiceDate])
  @@index([status])
  @@map("goods_receipt_invoices")
}

model GoodsReceiptInvoiceLine {
  id                 String  @id @default(uuid())
  invoiceId          String
  goodsReceiptLineId String  @unique
  productId          String
  sku                String
  productName        String
  hsnCode            String
  uqc                String
  quantity           Int
  unitValue          Decimal
  taxableValue       Decimal
  gstRate            Decimal
  cgstRate           Decimal
  cgstAmount         Decimal
  sgstRate           Decimal
  sgstAmount         Decimal
  igstRate           Decimal
  igstAmount         Decimal
  lineTotal          Decimal

  invoice          GoodsReceiptInvoice @relation(fields: [invoiceId], references: [id])
  goodsReceiptLine GoodsReceiptLine    @relation(fields: [goodsReceiptLineId], references: [id])
  product          Product             @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@map("goods_receipt_invoice_lines")
}

model InventoryMovement {
  id                 String                @id @default(uuid())
  warehouseId        String
  productId          String
  goodsReceiptId     String
  goodsReceiptLineId String
  movementType       InventoryMovementType
  quantityDelta      Int
  createdById        String
  reason             String?
  createdAt          DateTime              @default(now())

  warehouse        Warehouse        @relation(fields: [warehouseId], references: [id])
  product          Product          @relation(fields: [productId], references: [id])
  goodsReceipt     GoodsReceipt     @relation(fields: [goodsReceiptId], references: [id])
  goodsReceiptLine GoodsReceiptLine @relation(fields: [goodsReceiptLineId], references: [id])
  createdBy        User             @relation("InventoryMovementCreatedBy", fields: [createdById], references: [id])

  @@index([warehouseId, productId, createdAt])
  @@index([goodsReceiptId])
  @@map("inventory_movements")
}

model GoodsReceiptSequence {
  id                  String @id @default(uuid())
  sellerGstin         String
  financialYear       String
  lastGrnSequence     Int    @default(0)
  lastInvoiceSequence Int    @default(0)

  @@unique([sellerGstin, financialYear])
  @@map("goods_receipt_sequences")
}

model StockAdjustment {
  id            String   @id @default(uuid())
  warehouseId   String
  productId     String
  adjustmentQty Int
  reason        String
  adjustedById  String
  createdAt     DateTime @default(now())

  warehouse  Warehouse @relation(fields: [warehouseId], references: [id])
  product    Product   @relation(fields: [productId], references: [id])
  adjustedBy User      @relation("StockAdjustedBy", fields: [adjustedById], references: [id])

  @@index([warehouseId, productId, createdAt])
  @@index([adjustedById])
  @@map("stock_adjustments")
}

// =============================================================================
// ORDERS
// =============================================================================

model SaleOrder {
  id                  String        @id @default(uuid())
  orderNumber         String        @unique
  outletId            String
  orderType           String        @default("sale")
  sourceComplaintId   String?
  sourceWarehouseId   String?
  suppressAutoInvoice Boolean       @default(false)
  serviceMetadata     Json?
  createdById         String?
  orderDate           DateTime      @default(now())
  deliveryAddress     String
  status              OrderStatus   @default(pending_approval)
  priority            OrderPriority @default(medium)
  subtotalValue       Decimal       @default(0)
  discountType        ChargeType?
  discountRate        Decimal       @default(0)
  discountAmount      Decimal       @default(0)
  taxableValue        Decimal       @default(0)
  taxSnapshot         Json?
  taxTotal            Decimal       @default(0)
  paymentTermsDays    Int           @default(30)
  totalValue          Decimal       @default(0)

  approvedById    String?
  approvedAt      DateTime?
  heldById        String?
  heldAt          DateTime?
  holdNote        String?
  approvalNote    String?
  rejectionReason String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  outlet          Outlet            @relation(fields: [outletId], references: [id])
  sourceComplaint ServiceComplaint? @relation("ComplaintReplacementOrders", fields: [sourceComplaintId], references: [id])
  sourceWarehouse Warehouse?        @relation("ServiceSourceWarehouse", fields: [sourceWarehouseId], references: [id])
  createdBy       User?             @relation("OrderCreatedBy", fields: [createdById], references: [id])
  approvedBy      User?             @relation("OrderApprovedBy", fields: [approvedById], references: [id])
  heldBy          User?             @relation("OrderHeldBy", fields: [heldById], references: [id])

  lines                SaleOrderLine[]
  invoice              Invoice? // 1:1 — auto-generated on approval
  warrantyDecisionLink ServiceWarrantyDecision? @relation("ServiceWarrantyReplacementOrder")

  // Dispatches are resolved via DispatchLine → SaleOrderLine → SaleOrder
  // Query: DispatchLine.findMany({ where: { orderLine: { orderId: id } } })

  @@index([outletId, status])
  @@index([orderType, status])
  @@index([sourceComplaintId])
  @@index([sourceWarehouseId])
  @@index([status, priority, createdAt])
  @@map("sale_orders")
}

model SaleOrderLine {
  id            String          @id @default(uuid())
  orderId       String
  productId     String
  sku           String
  qtyOrdered    Int
  qtyDispatched Int             @default(0)
  unitPrice     Decimal
  lineTotal     Decimal         @default(0)
  status        OrderLineStatus @default(pending)

  order         SaleOrder      @relation(fields: [orderId], references: [id])
  product       Product        @relation(fields: [productId], references: [id])
  dispatchLines DispatchLine[]

  @@index([orderId])
  @@map("sale_order_lines")
}

// =============================================================================
// DISPATCH  —  one dispatch can cover lines from multiple orders
// =============================================================================

model Dispatch {
  id          String @id @default(uuid())
  warehouseId String

  // Required transport metadata
  transporterName String
  vehicleNumber   String
  lrNumber        String?

  dispatchDate      DateTime  @default(now())
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  deliveryStatus    String    @default("created") // created | in_transit | delivered
  idempotencyKey    String?   @unique
  createdById       String
  createdAt         DateTime  @default(now())

  warehouse Warehouse          @relation(fields: [warehouseId], references: [id])
  createdBy User               @relation(fields: [createdById], references: [id])
  lines     DispatchLine[]
  timeline  DispatchTimeline[]

  @@index([warehouseId])
  @@index([deliveryStatus])
  @@map("dispatches")
}

model DispatchLine {
  id            String @id @default(uuid())
  dispatchId    String
  orderLineId   String // order resolved through here: orderLine.orderId
  productId     String
  sku           String
  qtyDispatched Int

  // Flat JSON array — not normalised on DB, normalised at query layer
  // e.g. ["SN-001", "SN-002"]
  serialNumbers Json @default("[]")

  dispatch  Dispatch             @relation(fields: [dispatchId], references: [id])
  orderLine SaleOrderLine        @relation(fields: [orderLineId], references: [id])
  product   Product              @relation(fields: [productId], references: [id])
  serials   DispatchLineSerial[]

  @@index([dispatchId])
  @@index([orderLineId])
  @@map("dispatch_lines")
}

// Normalized serial lookup index — one row per (dispatch_line, normalized_serial).
// Enables O(log N) lookup in findSerialLegacyDispatchRows instead of full-table JS filter.
// Backfill: bun backend/src/scripts/backfill-dispatch-line-serials.ts
model DispatchLineSerial {
  id               String @id @default(uuid())
  dispatchLineId   String
  normalizedSerial String

  dispatchLine DispatchLine @relation(fields: [dispatchLineId], references: [id], onDelete: Cascade)

  @@unique([dispatchLineId, normalizedSerial])
  @@index([normalizedSerial])
  @@index([dispatchLineId])
  @@map("dispatch_line_serials")
}

model DispatchTimeline {
  id         String   @id @default(uuid())
  dispatchId String
  status     String // created | in_transit | delivered
  actorId    String?
  actorRole  String? // "admin" | "warehouse" | "outlet"
  note       String?
  happenedAt DateTime @default(now())

  dispatch Dispatch @relation(fields: [dispatchId], references: [id])
  actor    User?    @relation("DispatchTimelineActor", fields: [actorId], references: [id])

  @@index([dispatchId])
  @@map("dispatch_timeline")
}

// =============================================================================
// FINANCIALS  —  Invoices + Outlet Payments (FIFO clearing)
// =============================================================================

// Auto-generated when order is approved. No createdBy — system action.
model Invoice {
  id             String      @id @default(uuid())
  invoiceNumber  String      @unique
  orderId        String      @unique // 1:1 with SaleOrder
  outletId       String
  invoiceDate    DateTime    @default(now())
  dueDate        DateTime?
  subtotal       Decimal
  discountType   ChargeType?
  discountRate   Decimal     @default(0)
  discountAmount Decimal     @default(0)
  taxSnapshot    Json?
  total          Decimal
  amountPaid     Decimal     @default(0)
  amountDue      Decimal // kept in sync: total - amountPaid
  createdAt      DateTime    @default(now())

  order            SaleOrder                 @relation(fields: [orderId], references: [id])
  outlet           Outlet                    @relation(fields: [outletId], references: [id])
  lines            InvoiceLine[]
  charges          InvoiceCharge[]
  allocations      OutletPaymentAllocation[]
  warrantyDecision ServiceWarrantyDecision?  @relation("ServiceWarrantyReplacementInvoice")

  // Fast FIFO query: unpaid invoices per outlet ordered by invoiceDate ASC
  @@index([outletId, amountDue])
  @@index([outletId, invoiceDate])
  @@index([outletId, dueDate])
  @@map("invoices")
}

model InvoiceLine {
  id        String  @id @default(uuid())
  invoiceId String
  productId String
  sku       String
  qty       Int
  unitPrice Decimal
  lineTotal Decimal

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("invoice_lines")
}

// A single payment received from an outlet
model OutletPayment {
  id             String    @id @default(uuid())
  outletId       String
  amount         Decimal
  paymentDate    DateTime
  reference      String?
  description    String?
  idempotencyKey String?   @unique
  voidedAt       DateTime?
  voidedById     String?
  voidReason     String?
  createdAt      DateTime  @default(now())

  outlet      Outlet                    @relation(fields: [outletId], references: [id])
  allocations OutletPaymentAllocation[]
  reversal    OutletPaymentReversal?

  @@index([outletId, paymentDate])
  @@index([voidedAt])
  @@map("outlet_payments")
}

// Immutable audit row created when a payment is voided. The original payment
// remains visible in history and this row restores invoice/outlet balances.
model OutletPaymentReversal {
  id           String   @id @default(uuid())
  paymentId    String   @unique
  outletId     String
  amount       Decimal
  reason       String
  reversedById String?
  reversedAt   DateTime @default(now())

  payment    OutletPayment @relation(fields: [paymentId], references: [id])
  outlet     Outlet        @relation(fields: [outletId], references: [id])
  reversedBy User?         @relation("PaymentReversedBy", fields: [reversedById], references: [id])

  @@index([outletId, reversedAt])
  @@index([reversedById])
  @@map("outlet_payment_reversals")
}

// Each row = how much of one payment was applied to one invoice (FIFO split)
model OutletPaymentAllocation {
  id          String   @id @default(uuid())
  paymentId   String
  invoiceId   String
  amount      Decimal
  allocatedAt DateTime @default(now())

  payment OutletPayment @relation(fields: [paymentId], references: [id])
  invoice Invoice       @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([paymentId])
  @@map("outlet_payment_allocations")
}

// Admin-managed tax/charge configurations applied globally to every invoice.
model TaxCharge {
  id           String     @id @default(uuid())
  name         String
  type         ChargeType
  rate         Decimal
  isActive     Boolean    @default(true)
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  invoiceCharges InvoiceCharge[]

  @@index([isActive, displayOrder])
  @@map("tax_charges")
}

model BillingProfile {
  id                 String             @id @default(uuid())
  legalName          String
  gstin              String             @unique
  pan                String
  addressLine1       String
  addressLine2       String?
  city               String
  state              String
  stateCode          String
  pincode            String
  country            String             @default("India")
  contactName        String?
  contactPhone       String?
  contactEmail       String?
  logoUrl            String?
  profileType        BillingProfileType
  canIssueGrnInvoice Boolean            @default(false)
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  warehouse            Warehouse?     @relation("WarehouseBillingProfile")
  outlet               Outlet?        @relation("OutletBillingProfile")
  sourcedGoodsReceipts GoodsReceipt[] @relation("GoodsReceiptSourceProfile")

  @@index([profileType, isActive])
  @@map("billing_profiles")
}

// Snapshot of charges applied to an invoice at generation time — immutable.
model InvoiceCharge {
  id           String     @id @default(uuid())
  invoiceId    String
  taxChargeId  String? // null = ad-hoc charge not from global config
  name         String
  type         ChargeType
  rate         Decimal
  amount       Decimal
  displayOrder Int        @default(0)

  invoice   Invoice    @relation(fields: [invoiceId], references: [id])
  taxCharge TaxCharge? @relation(fields: [taxChargeId], references: [id])

  @@index([invoiceId])
  @@map("invoice_charges")
}

// =============================================================================
// NOTIFICATIONS
// =============================================================================

model Notification {
  id          String              @id @default(uuid())
  userId      String
  title       String
  body        String
  entityType  String
  entityId    String
  channel     NotificationChannel
  isRead      Boolean             @default(false)
  deliveredAt DateTime?
  readAt      DateTime?
  createdAt   DateTime            @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// =============================================================================
// ATTACHMENTS — polymorphic via entityType + entityId (no typed FK relations)
// =============================================================================

model Attachment {
  id                      String   @id @default(uuid())
  entityType              String // "order" | "dispatch" | "invoice" etc.
  entityId                String
  fileName                String
  mimeType                String
  fileSize                Int
  storageKey              String
  uploadedById            String?
  uploadedByServiceUserId String?
  isConfirmed             Boolean  @default(false)
  createdAt               DateTime @default(now())

  uploader           User?        @relation("AttachmentUploadedByUser", fields: [uploadedById], references: [id])
  serviceUserUploader ServiceUser? @relation("AttachmentUploadedByServiceUser", fields: [uploadedByServiceUserId], references: [id])
  pendingUpload      PendingUpload?

  @@index([entityType, entityId])
  @@index([uploadedByServiceUserId])
  @@map("attachments")
}

model PendingUpload {
  id           String   @id @default(uuid())
  attachmentId String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  attachment Attachment @relation(fields: [attachmentId], references: [id])

  @@map("pending_uploads")
}

// =============================================================================
// AUDIT LOG
// =============================================================================

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  meta       Json?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

// =============================================================================
// SEQUENCES  —  human-readable numbering
// =============================================================================

model InvoiceSequence {
  year         Int @id
  lastSequence Int @default(0)

  @@map("invoice_sequences")
}

model OrderSequence {
  year         Int @id
  lastSequence Int @default(0)

  @@map("order_sequences")
}

// =============================================================================
// FIELD SENSE  —  Shift lifecycle, GPS tracking, visits, attendance, schedules
// =============================================================================

enum ShiftStatus {
  active
  completed
}

enum ShiftStartType {
  auto
  manual
}

enum ShiftEndType {
  auto
  manual
  extended
}

enum AttendanceStatus {
  present
  absent
  half_day
  leave
}

model Shift {
  id              String         @id @default(uuid())
  agentId         String
  orgId           String
  clientShiftId   String?
  syncState       String?
  clientStartedAt DateTime?
  clientEndedAt   DateTime?
  startedAt       DateTime       @default(now())
  endedAt         DateTime?
  startType       ShiftStartType
  endType         ShiftEndType?
  status          ShiftStatus    @default(active)

  agent     User            @relation(fields: [agentId], references: [id])
  locations FieldLocation[]
  visits    FieldVisit[]
  stops     FieldStop[]

  @@unique([orgId, agentId, clientShiftId])
  @@index([agentId, status])
  @@index([orgId, status])
  @@index([agentId, startedAt])
  @@index([status, startedAt])
  @@index([orgId, agentId, clientShiftId])
  @@map("shifts")
}

model FieldLocation {
  id            String    @id @default(uuid())
  agentId       String
  shiftId       String
  orgId         String
  clientPointId String?
  clientShiftId String?
  lat           Float
  lng           Float
  accuracy      Float
  recordedAt    DateTime
  capturedAt    DateTime?
  source        String?
  platform      String?
  appVersion    String?
  altitude      Float?
  speed         Float?
  heading       Float?
  isMocked      Boolean?
  receivedAt    DateTime  @default(now())

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([orgId, agentId, clientPointId])
  @@index([agentId, recordedAt])
  @@index([shiftId, recordedAt])
  @@index([orgId, recordedAt])
  @@index([orgId, receivedAt])
  @@index([receivedAt])
  @@index([orgId, agentId, clientPointId])
  @@map("field_locations")
}

model FieldSyncStatus {
  id                 String    @id @default(uuid())
  orgId              String
  agentId            String
  deviceId           String
  shiftId            String?
  clientShiftId      String?
  appVersion         String?
  platform           String?
  lastCapturedAt     DateTime?
  lastReceivedAt     DateTime?
  lastSyncAttemptAt  DateTime?
  lastSyncErrorCode  String?
  pendingQueueDepth  Int?
  permissionsSummary Json?
  isActive           Boolean   @default(true)
  updatedAt          DateTime  @updatedAt

  agent User @relation(fields: [agentId], references: [id])

  @@unique([orgId, agentId, deviceId])
  @@index([orgId, updatedAt])
  @@index([agentId, updatedAt])
  @@map("field_sync_statuses")
}

model ShiftSchedule {
  id            String   @id @default(uuid())
  userId        String   @unique
  orgId         String
  autoStartTime String
  timezone      String   @default("Asia/Kolkata")
  isEnabled     Boolean  @default(true)
  updatedBy     String?
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([orgId, isEnabled])
  @@map("shift_schedules")
}

model FieldVisit {
  id            String   @id @default(uuid())
  agentId       String
  shiftId       String
  orgId         String
  lat           Float
  lng           Float
  description   String?
  audioUrl      String?
  outletId      String?
  customerId    String?
  clientEventId String?
  recordedAt    DateTime
  createdAt     DateTime @default(now())

  agent    User    @relation("FieldVisitAgent", fields: [agentId], references: [id])
  shift    Shift   @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  outlet   Outlet? @relation(fields: [outletId], references: [id])
  customer User?   @relation("FieldVisitCustomer", fields: [customerId], references: [id])

  // P0-4: Scoped to org so the same clientEventId can be used across different orgs.
  @@unique([orgId, clientEventId])
  @@index([agentId, recordedAt])
  @@index([shiftId])
  @@index([outletId])
  @@index([customerId])
  @@index([outletId, customerId, createdAt])
  @@map("field_visits")
}

model FieldStop {
  id            String    @id @default(uuid())
  agentId       String
  shiftId       String
  orgId         String
  lat           Float
  lng           Float
  reason        String?
  notes         String?
  clientEventId String?
  startedAt     DateTime
  endedAt       DateTime?
  createdAt     DateTime  @default(now())

  agent User  @relation(fields: [agentId], references: [id])
  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  // P0-4: Scoped to org so the same clientEventId can be used across different orgs.
  @@unique([orgId, clientEventId])
  @@index([agentId, startedAt])
  @@index([shiftId])
  @@map("field_stops")
}

model DailyAttendance {
  id        String           @id @default(uuid())
  userId    String
  orgId     String
  date      String
  status    AttendanceStatus
  markedBy  String?
  note      String?
  markedAt  DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([orgId, date])
  @@map("daily_attendance")
}

// =============================================================================
// SERVICE  —  Complaints, serial intelligence, warranty fulfillment
// =============================================================================

model ServiceUser {
  id           String   @id @default(uuid())
  name         String
  phone        String   @unique
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  complaints          ServiceComplaint[]  @relation("ServiceComplaintRaisedByServiceUser")
  sessions            ServiceUserSession[]
  attachmentsUploaded Attachment[]        @relation("AttachmentUploadedByServiceUser")

  @@map("service_users")
}

model ServiceUserSession {
  id               String    @id @default(uuid())
  serviceUserId    String
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  serviceUser ServiceUser @relation(fields: [serviceUserId], references: [id], onDelete: Cascade)

  @@index([serviceUserId])
  @@index([expiresAt])
  @@map("service_user_sessions")
}

model ServiceComplaint {
  id              String                 @id @default(uuid())
  complaintNumber String                 @unique
  orgId           String?
  status          ServiceComplaintStatus @default(raised)

  // raiser: exactly one of these is set (enforced in app layer)
  raisedByUserId        String?
  raisedByServiceUserId String?

  issueCategory String
  title         String?
  description   String?
  customerName  String?
  customerPhone String?

  complainantType ServiceComplainantType @default(self)
  thirdPartyName  String?
  thirdPartyPhone String?

  // customer location (critical for field dispatch routing)
  customerState   String?
  customerCity    String?
  customerPincode String?
  customerAddress String?
  alternatePhone  String?

  // stage-entry timestamps (H01)
  assignedAt DateTime?
  visitAt    DateTime?
  testedAt   DateTime?
  decidedAt  DateTime?

  telephonicReason String?
  resolutionNote   String?
  closedAt         DateTime?
  cancelledAt      DateTime?
  reopenedAt       DateTime?

  // resolution sub-type (queryable, set at each terminal transition)
  resolutionReason ServiceResolutionReason?

  // post-resolution happy calling queue
  happyCallingStatus ServiceHappyCallingStatus?
  happyCallingNote   String?
  physicalReturnAt   DateTime?
  physicalReturnNote String?

  // RSM denormalized from ASI at assignment time
  rsmUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  raisedByUser        User?                      @relation("ServiceComplaintRaisedByUser", fields: [raisedByUserId], references: [id])
  raisedByServiceUser ServiceUser?               @relation("ServiceComplaintRaisedByServiceUser", fields: [raisedByServiceUserId], references: [id])
  rsmUser             User?                      @relation("ServiceComplaintRsm", fields: [rsmUserId], references: [id])
  lines               ServiceComplaintLine[]
  assignments         ServiceAssignmentHistory[]
  testReports         ServiceTestReport[]
  activities          ServiceComplaintActivity[]
  warrantyDecision    ServiceWarrantyDecision?
  replacementOrders   SaleOrder[]                @relation("ComplaintReplacementOrders")
  formSubmissions     ServiceFormSubmission[]

  @@index([orgId, status, createdAt])
  @@index([orgId, customerState, status, createdAt])
  @@index([status, createdAt])
  @@index([raisedByServiceUserId, createdAt])
  @@index([raisedByUserId, createdAt])
  @@index([rsmUserId, createdAt])
  @@index([happyCallingStatus, createdAt])
  @@map("service_complaints")
}

model ServiceComplaintLine {
  id                          String   @id @default(uuid())
  complaintId                 String
  sku                         String
  serialNumber                String
  normalizedSerial            String
  productId                   String?
  replacementSerialNumber     String?
  normalizedReplacementSerial String?
  notes                       String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  complaint   ServiceComplaint    @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  product     Product?            @relation(fields: [productId], references: [id])
  testReports ServiceTestReport[]

  @@index([complaintId])
  @@index([normalizedSerial])
  @@index([normalizedReplacementSerial])
  @@map("service_complaint_lines")
}

model ServiceAssignmentHistory {
  id           String                  @id @default(uuid())
  complaintId  String
  asiUserId    String?
  seUserId     String?
  assignedById String
  action       ServiceAssignmentAction
  note         String?
  createdAt    DateTime                @default(now())

  complaint  ServiceComplaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  asiUser    User?            @relation("ServiceAssignmentAsi", fields: [asiUserId], references: [id])
  seUser     User?            @relation("ServiceAssignmentSe", fields: [seUserId], references: [id])
  assignedBy User             @relation("ServiceAssignmentBy", fields: [assignedById], references: [id])

  @@index([complaintId, createdAt])
  @@index([asiUserId, createdAt])
  @@index([seUserId, createdAt])
  @@map("service_assignment_history")
}

model ServiceTestReport {
  id              String             @id @default(uuid())
  complaintId     String
  complaintLineId String?
  submittedById   String
  verdict         ServiceTestVerdict
  summary         String?
  causeOfFailure  String?
  structuredData  Json?
  createdAt       DateTime           @default(now())

  complaint       ServiceComplaint        @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  complaintLine   ServiceComplaintLine?   @relation(fields: [complaintLineId], references: [id])
  submittedBy     User                    @relation("ServiceTestSubmittedBy", fields: [submittedById], references: [id])
  formSubmissions ServiceFormSubmission[]

  @@index([complaintId, createdAt])
  @@index([submittedById, createdAt])
  @@map("service_test_reports")
}

model ServiceComplaintActivity {
  id          String                  @id @default(uuid())
  complaintId String
  actorId     String?
  action      String
  fromStatus  ServiceComplaintStatus?
  toStatus    ServiceComplaintStatus?
  note        String?
  meta        Json?
  createdAt   DateTime                @default(now())

  complaint ServiceComplaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  actor     User?            @relation("ServiceActivityActor", fields: [actorId], references: [id])

  @@index([complaintId, createdAt])
  @@index([actorId, createdAt])
  @@map("service_complaint_activities")
}

model ServiceWarrantyDecision {
  id          String                        @id @default(uuid())
  complaintId String                        @unique
  status      ServiceWarrantyDecisionStatus @default(pending)
  decidedById String?

  fulfillmentRoute     ServiceFulfillmentRoute?
  sourceWarehouseId    String?
  sourceOutletId       String?
  claimingOutletId     String?
  replacementOrderId   String?                  @unique
  replacementInvoiceId String?                  @unique

  proRataPercent Int? // 0–100, pro-rata warranty coverage percentage

  approvedReplacementSerial String?
  rejectionReason           String?
  decidedAt                 DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  complaint          ServiceComplaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  decidedBy          User?            @relation("ServiceWarrantyDecidedBy", fields: [decidedById], references: [id])
  sourceWarehouse    Warehouse?       @relation(fields: [sourceWarehouseId], references: [id])
  sourceOutlet       Outlet?          @relation("ServiceWarrantySourceOutlet", fields: [sourceOutletId], references: [id])
  claimingOutlet     Outlet?          @relation("ServiceWarrantyClaimingOutlet", fields: [claimingOutletId], references: [id])
  replacementOrder   SaleOrder?       @relation("ServiceWarrantyReplacementOrder", fields: [replacementOrderId], references: [id])
  replacementInvoice Invoice?         @relation("ServiceWarrantyReplacementInvoice", fields: [replacementInvoiceId], references: [id])

  @@index([status, createdAt])
  @@index([sourceWarehouseId])
  @@index([claimingOutletId])
  @@map("service_warranty_decisions")
}

model ServiceSerialIndex {
  id               String   @id @default(uuid())
  normalizedSerial String   @unique
  orgId            String?
  serialNumber     String
  productId        String?
  soldOutletId     String?
  firstSeenAt      DateTime @default(now())
  lastSeenAt       DateTime @default(now())
  hydratedLegacy   Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product    Product? @relation(fields: [productId], references: [id])
  soldOutlet Outlet?  @relation(fields: [soldOutletId], references: [id])

