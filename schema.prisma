}

model ServiceSerialEvent {
  id               String                  @id @default(uuid())
  normalizedSerial String
  orgId            String?
  eventType        ServiceSerialEventType
  entityType       ServiceSerialEntityType
  entityId         String
  eventAt          DateTime                @default(now())
  meta             Json?
  createdAt        DateTime                @default(now())

  @@unique([normalizedSerial, entityType, entityId, eventType])
  @@index([orgId, normalizedSerial, eventAt])
  @@index([normalizedSerial, eventAt])
  @@index([entityType, entityId])
  @@map("service_serial_events")
