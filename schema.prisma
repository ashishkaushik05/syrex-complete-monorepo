// =============================================================================
// Unified Operations Platform — Prisma Schema
// Version: 3.1 | May 2026
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "./backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserType {
  internal
  outlet
}

enum OrderStatus {
  pending_approval
  approved
  partially_dispatched
  fully_dispatched
  rejected
  cancelled
  on_hold
}

enum OrderPriority {
  low
  medium
  high
  critical
}

enum OrderLineStatus {
  pending
  partially_dispatched
  fully_dispatched
}

enum NotificationChannel {
  in_app
  push
  sms
}

enum GoodsReceiptSourceType {
  manual
  production_line_movement
}

enum ServiceComplaintStatus {
  raised
  assigned
  visit
  test_result_submitted
  retest_requested
  resolved
  telephonic_closure
  cancelled
}

enum ServiceFormFieldType {
  text
  textarea
  number
  boolean
  select
  multiselect
  date
}

enum ServiceWarrantyDecisionStatus {
  pending
  approved
  rejected
}

enum ServiceMachineClientStatus {
  active
  revoked
}

enum ChargeType {
  percentage
  fixed
}

// =============================================================================
// AUTH + ROLES
// =============================================================================

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  phone            String?
  name             String
  passwordHash     String
  userType         UserType
  roleId           String
  isActive         Boolean  @default(true)
  isFieldEnabled   Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  role                   Role               @relation(fields: [roleId], references: [id])
  outlet                 Outlet?
  notifications          Notification[]
  auditLogs              AuditLog[]
  invitationsSent        UserInvitation[]   @relation("InvitedBy")
  invitationsAccepted    UserInvitation[]   @relation("AcceptedUser")
  attachmentsUploaded    Attachment[]
  ordersCreated          SaleOrder[]        @relation("OrderCreatedBy")
  ordersApproved         SaleOrder[]        @relation("OrderApprovedBy")
  ordersHeld             SaleOrder[]        @relation("OrderHeldBy")
  dispatchesCreated      Dispatch[]
  stockAdjustments       StockAdjustment[]  @relation("StockAdjustedBy")
  managedWarehouse       Warehouse?         @relation("WarehouseManager")
  authSessions           AuthSession[]
  shifts                 Shift[]
  fieldSyncStatuses      FieldSyncStatus[]
  fieldVisits            FieldVisit[] @relation("FieldVisitAgent")
  fieldVisitsAsCustomer  FieldVisit[] @relation("FieldVisitCustomer")
  fieldStops             FieldStop[]
  attendance             DailyAttendance[]
  shiftSchedule          ShiftSchedule?
  serviceComplaintsRaised ServiceComplaint[] @relation("ServiceComplaintRaisedBy")
  serviceAssignmentsAsi  ServiceAssignmentHistory[] @relation("ServiceAssignmentAsi")
  serviceAssignmentsSe   ServiceAssignmentHistory[] @relation("ServiceAssignmentSe")
  serviceAssignmentsBy   ServiceAssignmentHistory[] @relation("ServiceAssignmentBy")
  serviceTestsSubmitted  ServiceTestReport[] @relation("ServiceTestSubmittedBy")
  serviceActivities      ServiceComplaintActivity[] @relation("ServiceActivityActor")
  serviceWarrantyDecisions ServiceWarrantyDecision[] @relation("ServiceWarrantyDecidedBy")
  serviceMachineClientsCreated ServiceMachineClient[] @relation("ServiceMachineClientCreatedBy")
  serviceFormTemplatesCreated  ServiceFormTemplate[]  @relation("ServiceFormTemplateCreatedBy")
  serviceFormSubmissions       ServiceFormSubmission[] @relation("ServiceFormSubmittedBy")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions String[] @default([])
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  users User[]

  @@map("roles")
}

model UserInvitation {
  id             String    @id @default(uuid())
  email          String
  name           String
  role           String
  token          String    @unique
  status         String    @default("pending")
  invitedById    String
  acceptedUserId String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  invitedBy    User  @relation("InvitedBy", fields: [invitedById], references: [id])
  acceptedUser User? @relation("AcceptedUser", fields: [acceptedUserId], references: [id])

  @@index([email, status])
  @@map("user_invitations")
}

model AuthSession {
  id           String    @id @default(uuid())
  userId       String
  accessToken  String    @unique
  refreshToken String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

// =============================================================================
// OUTLETS
// =============================================================================

model Outlet {
  id                 String   @id @default(uuid())
  outletCode         String   @unique
  userId             String   @unique
  name               String
  ownerName          String
  phone              String
  address            String
  creditLimit        Decimal  @default(0)
  outstandingBalance Decimal  @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  // Billing / GST details
  legalName       String?
  gstin           String?
  billingAddress1 String?
  billingAddress2 String?
  billingCity     String?
  billingState    String?
  billingPincode  String?
  billingCountry  String   @default("India")

  // Single warehouse that serves this outlet
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  user        User       @relation(fields: [userId], references: [id])

  orders   SaleOrder[]
  invoices Invoice[]
  payments OutletPayment[]
  serviceComplaints ServiceComplaint[]
  serviceSerialsSold ServiceSerialIndex[]
  fieldVisits FieldVisit[]

  @@map("outlets")
}

// =============================================================================
// CATALOG  —  Brand → Category → Product
// =============================================================================

model Brand {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories Category[]
  images     Image[]    @relation("BrandImages")

  @@map("brands")
}

model Category {
  id          String   @id @default(uuid())
  brandId     String
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand    Brand     @relation(fields: [brandId], references: [id])
  products Product[]
  images   Image[]   @relation("CategoryImages")

  @@unique([brandId, name])
  @@map("categories")
}

model Product {
  id             String   @id @default(uuid())
  categoryId     String
  name           String
  displayName    String?
  sku            String   @unique
  description    String?
  specs          Json?
  warrantyMonths Int
  basePrice      Decimal
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category          Category             @relation(fields: [categoryId], references: [id])
  images            Image[]              @relation("ProductImages")
  orderLines        SaleOrderLine[]
  invoiceLines      InvoiceLine[]
  dispatchLines     DispatchLine[]
  warehouseStocks   WarehouseStock[]
  goodsReceiptLines GoodsReceiptLine[]
  stockAdjustments  StockAdjustment[]
  serviceComplaintLines ServiceComplaintLine[]
  serviceSerialIndexRows ServiceSerialIndex[]

  @@index([categoryId, isActive])
  @@map("products")
}

// One row per image. Exactly one of brandId / categoryId / productId is set.
model Image {
  id        String   @id @default(uuid())
  uri       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  brandId    String?
  categoryId String?
  productId  String?

  brand    Brand?    @relation("BrandImages",    fields: [brandId],    references: [id])
  category Category? @relation("CategoryImages", fields: [categoryId], references: [id])
  product  Product?  @relation("ProductImages",  fields: [productId],  references: [id])

  @@index([brandId])
  @@index([categoryId])
  @@index([productId])
  @@map("images")
}

// =============================================================================
// WAREHOUSE + STOCK
// =============================================================================

model Warehouse {
  id        String   @id @default(uuid())
  name      String
  location  String
  address   String?
  managerId String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  manager       User?            @relation("WarehouseManager", fields: [managerId], references: [id])
  outlets       Outlet[]
  stock         WarehouseStock[]
  receipts      GoodsReceipt[]
  adjustments   StockAdjustment[]
  dispatches    Dispatch[]
  serviceSourceOrders SaleOrder[] @relation("ServiceSourceWarehouse")
  serviceWarrantyDecisions ServiceWarrantyDecision[]

  @@index([managerId])
  @@map("warehouses")
}

model WarehouseStock {
  id           String   @id @default(uuid())
  warehouseId  String
  productId    String
  currentQty   Int      @default(0)
  reservedQty  Int      @default(0)
  inTransitQty Int      @default(0)
  updatedAt    DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId])
  @@index([productId])
  @@map("warehouse_stocks")
}


model GoodsReceipt {
  id            String   @id @default(uuid())
  warehouseId   String
  sourceType    GoodsReceiptSourceType
  sourceBatchId String?
  receiptDate   DateTime @default(now())
  notes         String?
  createdAt     DateTime @default(now())

  warehouse Warehouse          @relation(fields: [warehouseId], references: [id])
  lines     GoodsReceiptLine[]

  @@index([warehouseId, receiptDate])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id          String @id @default(uuid())
  grnId       String
  productId   String
  qtyReceived Int

  grn     GoodsReceipt @relation(fields: [grnId], references: [id])
  product Product      @relation(fields: [productId], references: [id])

  @@map("goods_receipt_lines")
}

model StockAdjustment {
  id            String   @id @default(uuid())
  warehouseId   String
  productId     String
  adjustmentQty Int
  reason        String
  adjustedById  String
  createdAt     DateTime @default(now())

  warehouse  Warehouse @relation(fields: [warehouseId], references: [id])
  product    Product   @relation(fields: [productId], references: [id])
  adjustedBy User      @relation("StockAdjustedBy", fields: [adjustedById], references: [id])

  @@index([warehouseId, productId, createdAt])
  @@index([adjustedById])
  @@map("stock_adjustments")
}

// =============================================================================
// ORDERS
// =============================================================================

model SaleOrder {
  id              String        @id @default(uuid())
  orderNumber     String        @unique
  outletId        String
  orderType       String        @default("sale")
  sourceComplaintId String?
  sourceWarehouseId String?
  suppressAutoInvoice Boolean   @default(false)
  serviceMetadata Json?
  createdById     String?
  orderDate       DateTime      @default(now())
  deliveryAddress String
  status          OrderStatus   @default(pending_approval)
  priority        OrderPriority @default(medium)
  totalValue      Decimal       @default(0)

  approvedById    String?
  approvedAt      DateTime?
  heldById        String?
  heldAt          DateTime?
  holdNote        String?
  approvalNote    String?
  rejectionReason String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  outlet     Outlet  @relation(fields: [outletId],    references: [id])
  sourceComplaint ServiceComplaint? @relation("ComplaintReplacementOrders", fields: [sourceComplaintId], references: [id])
  sourceWarehouse Warehouse? @relation("ServiceSourceWarehouse", fields: [sourceWarehouseId], references: [id])
  createdBy  User?   @relation("OrderCreatedBy",  fields: [createdById],  references: [id])
  approvedBy User?   @relation("OrderApprovedBy", fields: [approvedById], references: [id])
  heldBy     User?   @relation("OrderHeldBy",     fields: [heldById],     references: [id])

  lines   SaleOrderLine[]
  invoice Invoice?        // 1:1 — auto-generated on approval
  warrantyDecisionLink ServiceWarrantyDecision? @relation("ServiceWarrantyReplacementOrder")

  // Dispatches are resolved via DispatchLine → SaleOrderLine → SaleOrder
  // Query: DispatchLine.findMany({ where: { orderLine: { orderId: id } } })

  @@index([outletId, status])
  @@index([orderType, status])
  @@index([sourceComplaintId])
  @@index([sourceWarehouseId])
  @@index([status, priority, createdAt])
  @@map("sale_orders")
}

model SaleOrderLine {
  id            String          @id @default(uuid())
  orderId       String
  productId     String
  sku           String
  qtyOrdered    Int
  qtyDispatched Int             @default(0)
  unitPrice     Decimal
  lineTotal     Decimal         @default(0)
  status        OrderLineStatus @default(pending)

  order         SaleOrder      @relation(fields: [orderId],    references: [id])
  product       Product        @relation(fields: [productId],  references: [id])
  dispatchLines DispatchLine[]

  @@index([orderId])
  @@map("sale_order_lines")
}

// =============================================================================
// DISPATCH  —  one dispatch can cover lines from multiple orders
// =============================================================================

model Dispatch {
  id          String   @id @default(uuid())
  warehouseId String

  // Required transport metadata
  transporterName String
  vehicleNumber   String
  lrNumber        String?

  dispatchDate      DateTime  @default(now())
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  deliveryStatus    String    @default("created") // created | in_transit | delivered
  idempotencyKey    String?   @unique
  createdById       String
  createdAt         DateTime  @default(now())

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  createdBy User           @relation(fields: [createdById], references: [id])
  lines     DispatchLine[]

  @@index([warehouseId])
  @@map("dispatches")
}

model DispatchLine {
  id          String @id @default(uuid())
  dispatchId  String
  orderLineId String // order resolved through here: orderLine.orderId
  productId   String
  sku         String
  qtyDispatched Int

  // Flat JSON array — not normalised on DB, normalised at query layer
  // e.g. ["SN-001", "SN-002"]
  serialNumbers Json @default("[]")

  dispatch  Dispatch      @relation(fields: [dispatchId],  references: [id])
  orderLine SaleOrderLine @relation(fields: [orderLineId], references: [id])
  product   Product       @relation(fields: [productId],   references: [id])

  @@index([dispatchId])
  @@index([orderLineId])
  @@map("dispatch_lines")
}

// =============================================================================
// FINANCIALS  —  Invoices + Outlet Payments (FIFO clearing)
// =============================================================================

// Auto-generated when order is approved. No createdBy — system action.
model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique
  orderId       String   @unique // 1:1 with SaleOrder
  outletId      String
  invoiceDate   DateTime @default(now())
  subtotal      Decimal
  total         Decimal
  amountPaid    Decimal  @default(0)
  amountDue     Decimal  // kept in sync: total - amountPaid
  createdAt     DateTime @default(now())

  order       SaleOrder                 @relation(fields: [orderId],  references: [id])
  outlet      Outlet                    @relation(fields: [outletId], references: [id])
  lines       InvoiceLine[]
  charges     InvoiceCharge[]
  allocations OutletPaymentAllocation[]

  // Fast FIFO query: unpaid invoices per outlet ordered by invoiceDate ASC
  @@index([outletId, amountDue])
  @@index([outletId, invoiceDate])
  @@map("invoices")
}

model InvoiceLine {
  id        String  @id @default(uuid())
  invoiceId String
  productId String
  sku       String
  qty       Int
  unitPrice Decimal
  lineTotal Decimal

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("invoice_lines")
}

// A single payment received from an outlet
model OutletPayment {
  id             String   @id @default(uuid())
  outletId       String
  amount         Decimal
  paymentDate    DateTime
  reference      String?
  description    String?
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  outlet      Outlet                    @relation(fields: [outletId], references: [id])
  allocations OutletPaymentAllocation[]

  @@index([outletId, paymentDate])
  @@map("outlet_payments")
}

// Each row = how much of one payment was applied to one invoice (FIFO split)
model OutletPaymentAllocation {
  id          String   @id @default(uuid())
  paymentId   String
  invoiceId   String
  amount      Decimal
  allocatedAt DateTime @default(now())

  payment OutletPayment @relation(fields: [paymentId], references: [id])
  invoice Invoice       @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([paymentId])
  @@map("outlet_payment_allocations")
}



// Admin-managed tax/charge configurations applied globally to every invoice.
model TaxCharge {
  id           String     @id @default(uuid())
  name         String
  type         ChargeType
  rate         Decimal
  isActive     Boolean    @default(true)
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  invoiceCharges InvoiceCharge[]

  @@index([isActive, displayOrder])
  @@map("tax_charges")
}

// Singleton — one record holds the seller's (org's) billing identity shown on every invoice.
model OrgBillingProfile {
  id           String   @id @default(uuid())
  companyName  String   @default("")
  addressLine1 String   @default("")
  addressLine2 String   @default("")
  city         String   @default("")
  state        String   @default("")
  pincode      String   @default("")
  country      String   @default("India")
  gstin        String   @default("")
  pan          String   @default("")
  sacCode      String   @default("")
  logoUrl      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("org_billing_profile")
}

// Snapshot of charges applied to an invoice at generation time — immutable.
model InvoiceCharge {
  id           String     @id @default(uuid())
  invoiceId    String
  taxChargeId  String?   // null = ad-hoc charge not from global config
  name         String
  type         ChargeType
  rate         Decimal
  amount       Decimal
  displayOrder Int        @default(0)

  invoice   Invoice    @relation(fields: [invoiceId],   references: [id])
  taxCharge TaxCharge? @relation(fields: [taxChargeId], references: [id])

  @@index([invoiceId])
  @@map("invoice_charges")
}

// =============================================================================
// NOTIFICATIONS
// =============================================================================

model Notification {
  id          String              @id @default(uuid())
  userId      String
  title       String
  body        String
  entityType  String
  entityId    String
  channel     NotificationChannel
  isRead      Boolean             @default(false)
  deliveredAt DateTime?
  readAt      DateTime?
  createdAt   DateTime            @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// =============================================================================
// ATTACHMENTS — polymorphic via entityType + entityId (no typed FK relations)
// =============================================================================

model Attachment {
  id           String   @id @default(uuid())
  entityType   String   // "order" | "dispatch" | "invoice" etc.
  entityId     String
  fileName     String
  mimeType     String
  fileSize     Int
  storageKey   String
  uploadedById String
  isConfirmed  Boolean  @default(false)
  createdAt    DateTime @default(now())

  uploader      User          @relation(fields: [uploadedById], references: [id])
  pendingUpload PendingUpload?

  @@index([entityType, entityId])
  @@map("attachments")
}

model PendingUpload {
  id           String   @id @default(uuid())
  attachmentId String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  attachment Attachment @relation(fields: [attachmentId], references: [id])

  @@map("pending_uploads")
}

// =============================================================================
// AUDIT LOG
// =============================================================================

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  meta       Json?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

// =============================================================================
// SEQUENCES  —  human-readable numbering
// =============================================================================

model InvoiceSequence {
  year         Int @id
  lastSequence Int @default(0)

  @@map("invoice_sequences")
}

model OrderSequence {
  year         Int @id
  lastSequence Int @default(0)

  @@map("order_sequences")
}

// =============================================================================
// FIELD SENSE  —  Shift lifecycle, GPS tracking, visits, attendance, schedules
// =============================================================================

enum ShiftStatus {
  active
  completed
}

enum ShiftStartType {
  auto
  manual
}

enum ShiftEndType {
  auto
  manual
  extended
}

enum AttendanceStatus {
  present
  absent
  half_day
  leave
}

model Shift {
  id              String         @id @default(uuid())
  agentId         String
  orgId           String
  clientShiftId   String?
  syncState       String?
  clientStartedAt DateTime?
  clientEndedAt   DateTime?
  startedAt       DateTime       @default(now())
  endedAt         DateTime?
  startType       ShiftStartType
  endType         ShiftEndType?
  status          ShiftStatus    @default(active)

  agent     User            @relation(fields: [agentId], references: [id])
  locations FieldLocation[]
  visits    FieldVisit[]
  stops     FieldStop[]

  @@unique([orgId, agentId, clientShiftId])
  @@index([agentId, status])
  @@index([orgId, status])
  @@index([agentId, startedAt])
  @@index([orgId, agentId, clientShiftId])
  @@map("shifts")
}

model FieldLocation {
  id            String   @id @default(uuid())
  agentId       String
  shiftId       String
  orgId         String
  clientPointId String?
  clientShiftId String?
  lat           Float
  lng           Float
  accuracy      Float
  recordedAt    DateTime
  capturedAt    DateTime?
  source        String?
  platform      String?
  appVersion    String?
  altitude      Float?
  speed         Float?
  heading       Float?
  isMocked      Boolean?
  receivedAt    DateTime @default(now())

  shift Shift @relation(fields: [shiftId], references: [id])

  @@unique([orgId, agentId, clientPointId])
  @@index([agentId, recordedAt])
  @@index([shiftId, recordedAt])
  @@index([orgId, recordedAt])
  @@index([orgId, receivedAt])
  @@index([orgId, agentId, clientPointId])
  @@map("field_locations")
}

model FieldSyncStatus {
  id                 String   @id @default(uuid())
  orgId              String
  agentId            String
  deviceId           String
  shiftId            String?
  clientShiftId      String?
  appVersion         String?
  platform           String?
  lastCapturedAt     DateTime?
  lastReceivedAt     DateTime?
  lastSyncAttemptAt  DateTime?
  lastSyncErrorCode  String?
  pendingQueueDepth  Int?
  permissionsSummary Json?
  updatedAt          DateTime @updatedAt

  agent User @relation(fields: [agentId], references: [id])

  @@unique([orgId, agentId, deviceId])
  @@index([orgId, updatedAt])
  @@index([agentId, updatedAt])
  @@map("field_sync_statuses")
}

model ShiftSchedule {
  id            String   @id @default(uuid())
  userId        String   @unique
  orgId         String
  autoStartTime String
  timezone      String   @default("Asia/Kolkata")
  isEnabled     Boolean  @default(true)
  updatedBy     String?
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("shift_schedules")
}

model FieldVisit {
  id          String   @id @default(uuid())
  agentId     String
  shiftId     String
  orgId       String
  lat         Float
  lng         Float
  description String?
  audioUrl    String?
  outletId    String?
  customerId  String?
  recordedAt  DateTime
  createdAt   DateTime @default(now())

  agent    User    @relation("FieldVisitAgent", fields: [agentId], references: [id])
  shift    Shift   @relation(fields: [shiftId], references: [id])
  outlet   Outlet? @relation(fields: [outletId], references: [id])
  customer User?   @relation("FieldVisitCustomer", fields: [customerId], references: [id])

  @@index([agentId, recordedAt])
  @@index([shiftId])
  @@index([outletId])
  @@index([customerId])
  @@index([outletId, customerId, createdAt])
  @@map("field_visits")
}

model FieldStop {
  id         String    @id @default(uuid())
  agentId    String
  shiftId    String
  orgId      String
  lat        Float
  lng        Float
  reason     String?
  notes      String?
  startedAt  DateTime
  endedAt    DateTime?
  createdAt  DateTime  @default(now())

  agent User  @relation(fields: [agentId], references: [id])
  shift Shift @relation(fields: [shiftId], references: [id])

  @@index([agentId, startedAt])
  @@index([shiftId])
  @@map("field_stops")
}

model DailyAttendance {
  id       String           @id @default(uuid())
  userId   String
  orgId    String
  date     String
  status   AttendanceStatus
  markedBy String?
  note     String?
  markedAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([orgId, date])
  @@map("daily_attendance")
}

// =============================================================================
// SERVICE  —  Complaints, serial intelligence, warranty fulfillment
// =============================================================================

model ServiceComplaint {
  id               String                 @id @default(uuid())
  complaintNumber  String                 @unique
  status           ServiceComplaintStatus @default(raised)
  title            String?
  description      String?
  outletId         String?
  raisedById       String
  telephonicReason String?
  resolutionNote   String?
  closedAt         DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  outlet             Outlet?                    @relation(fields: [outletId], references: [id])
  raisedBy           User                       @relation("ServiceComplaintRaisedBy", fields: [raisedById], references: [id])
  lines              ServiceComplaintLine[]
  assignments        ServiceAssignmentHistory[]
  testReports        ServiceTestReport[]
  activities         ServiceComplaintActivity[]
  warrantyDecision   ServiceWarrantyDecision?
  replacementOrders  SaleOrder[]                @relation("ComplaintReplacementOrders")
  formSubmissions    ServiceFormSubmission[]

  @@index([status, createdAt])
  @@index([outletId, createdAt])
  @@map("service_complaints")
}

model ServiceComplaintLine {
  id                        String   @id @default(uuid())
  complaintId               String
  serialNumber              String
  normalizedSerial          String
  replacementSerialNumber   String?
  normalizedReplacementSerial String?
  productId                 String?
  notes                     String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  complaint ServiceComplaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  product   Product?         @relation(fields: [productId], references: [id])
  testReports ServiceTestReport[]

  @@index([complaintId])
  @@index([normalizedSerial])
  @@index([normalizedReplacementSerial])
  @@map("service_complaint_lines")
}

model ServiceAssignmentHistory {
  id           String   @id @default(uuid())
  complaintId  String
  asiUserId    String?
  seUserId     String?
  assignedById String
  action       String
  note         String?
  createdAt    DateTime @default(now())

  complaint  ServiceComplaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  asiUser    User?            @relation("ServiceAssignmentAsi", fields: [asiUserId], references: [id])
  seUser     User?            @relation("ServiceAssignmentSe", fields: [seUserId], references: [id])
  assignedBy User             @relation("ServiceAssignmentBy", fields: [assignedById], references: [id])

  @@index([complaintId, createdAt])
  @@map("service_assignment_history")
}

model ServiceTestReport {
  id             String   @id @default(uuid())
  complaintId    String
  complaintLineId String?
  submittedById  String
  verdict        String
  summary        String?
  structuredData Json?
  createdAt      DateTime @default(now())

  complaint     ServiceComplaint      @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  complaintLine ServiceComplaintLine? @relation(fields: [complaintLineId], references: [id])
  submittedBy   User                  @relation("ServiceTestSubmittedBy", fields: [submittedById], references: [id])
  formSubmissions ServiceFormSubmission[]

  @@index([complaintId, createdAt])
  @@map("service_test_reports")
}

model ServiceComplaintActivity {
  id           String   @id @default(uuid())
  complaintId  String
  actorId      String?
  action       String
  fromStatus   ServiceComplaintStatus?
  toStatus     ServiceComplaintStatus?
  note         String?
  meta         Json?
  createdAt    DateTime @default(now())

  complaint ServiceComplaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  actor     User?            @relation("ServiceActivityActor", fields: [actorId], references: [id])

  @@index([complaintId, createdAt])
  @@map("service_complaint_activities")
}

model ServiceWarrantyDecision {
  id                      String                        @id @default(uuid())
  complaintId             String                        @unique
  status                  ServiceWarrantyDecisionStatus @default(pending)
  decidedById             String?
  sourceWarehouseId       String?
  approvedReplacementSerial String?
  rejectionReason         String?
  replacementOrderId      String?                       @unique
  decidedAt               DateTime?
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt

  complaint        ServiceComplaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  decidedBy        User?            @relation("ServiceWarrantyDecidedBy", fields: [decidedById], references: [id])
  sourceWarehouse  Warehouse?       @relation(fields: [sourceWarehouseId], references: [id])
  replacementOrder SaleOrder?       @relation("ServiceWarrantyReplacementOrder", fields: [replacementOrderId], references: [id])

  @@index([status, createdAt])
  @@index([sourceWarehouseId])
  @@map("service_warranty_decisions")
}

model ServiceSerialIndex {
  id               String   @id @default(uuid())
  normalizedSerial String   @unique
  serialNumber     String
  productId        String?
  soldOutletId     String?
  firstSeenAt      DateTime @default(now())
  lastSeenAt       DateTime @default(now())
  hydratedLegacy   Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product    Product? @relation(fields: [productId], references: [id])
  soldOutlet Outlet?  @relation(fields: [soldOutletId], references: [id])

  @@index([soldOutletId, updatedAt])
  @@index([productId, updatedAt])
  @@map("service_serial_index")
}

model ServiceSerialEvent {
  id               String   @id @default(uuid())
  normalizedSerial String
  eventType        String
  entityType       String
  entityId         String
  eventAt          DateTime @default(now())
  meta             Json?
  createdAt        DateTime @default(now())

  @@index([normalizedSerial, eventAt])
  @@index([entityType, entityId])
  @@map("service_serial_events")
}

model ServiceComplaintSequence {
  year         Int @id
  lastSequence Int @default(0)

  @@map("service_complaint_sequences")
}

model ServiceMachineClient {
  id             String                     @id @default(uuid())
  clientId       String                     @unique
  name           String
  scopes         String[]                   @default([])
  secretHash     String
  secretLast4    String
  status         ServiceMachineClientStatus @default(active)
  expiresAt      DateTime?
  rotatedAt      DateTime                   @default(now())
  lastUsedAt     DateTime?
  createdById    String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  createdBy User?                      @relation("ServiceMachineClientCreatedBy", fields: [createdById], references: [id])
  auditLogs  ServiceMachineClientAudit[]

  @@index([status, createdAt])
  @@map("service_machine_clients")
}

// ── Form Templates ──────────────────────────────────────────────────────────

model ServiceFormTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User?                     @relation("ServiceFormTemplateCreatedBy", fields: [createdById], references: [id])
  fields      ServiceFormTemplateField[]
  submissions ServiceFormSubmission[]

  @@index([isActive, createdAt])
  @@map("service_form_templates")
}

model ServiceFormTemplateField {
  id              String              @id @default(uuid())
  templateId      String
  fieldKey        String
  label           String
  fieldType       ServiceFormFieldType
  isRequired      Boolean             @default(true)
  displayOrder    Int                 @default(0)
  validationRules Json?
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  template ServiceFormTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  values   ServiceFormSubmissionValue[]

  @@unique([templateId, fieldKey])
  @@index([templateId, displayOrder])
  @@map("service_form_template_fields")
}

model ServiceFormSubmission {
  id            String   @id @default(uuid())
  complaintId   String
  templateId    String
  submittedById String
  testReportId  String?
  isDisabled    Boolean  @default(false)
  disabledReason String?
  submittedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  complaint   ServiceComplaint    @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  template    ServiceFormTemplate @relation(fields: [templateId], references: [id])
  submittedBy User                @relation("ServiceFormSubmittedBy", fields: [submittedById], references: [id])
  testReport  ServiceTestReport?  @relation(fields: [testReportId], references: [id])
  values      ServiceFormSubmissionValue[]

  @@index([complaintId, createdAt])
  @@index([testReportId])
  @@map("service_form_submissions")
}

model ServiceFormSubmissionValue {
  id              String   @id @default(uuid())
  submissionId    String
  fieldId         String
  fieldKey        String
  rawValue        String
  isValid         Boolean
  validationError String?
  createdAt       DateTime @default(now())

  submission ServiceFormSubmission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  field      ServiceFormTemplateField @relation(fields: [fieldId], references: [id])

  @@unique([submissionId, fieldKey])
  @@index([submissionId])
  @@map("service_form_submission_values")
}

model ServiceMachineClientAudit {
  id              String   @id @default(uuid())
  serviceClientId String
  action          String
  actorId         String?
  meta            Json?
  createdAt       DateTime @default(now())

  client ServiceMachineClient @relation(fields: [serviceClientId], references: [id], onDelete: Cascade)

  @@index([serviceClientId, createdAt])
  @@map("service_machine_client_audit")
}
