model ServiceMachineClient {
  id          String                     @id @default(uuid())
  clientId    String                     @unique
  orgId       String?
  name        String
  scopes      String[]                   @default([])
  secretHash  String
  secretLast4 String
  status      ServiceMachineClientStatus @default(active)
  expiresAt   DateTime?
  rotatedAt   DateTime                   @default(now())
  lastUsedAt  DateTime?
  createdById String?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  createdBy User?                       @relation("ServiceMachineClientCreatedBy", fields: [createdById], references: [id])
  auditLogs ServiceMachineClientAudit[]

  @@index([orgId, status, createdAt])
  @@index([status, createdAt])
  @@map("service_machine_clients")
}

// ── Form Templates ──────────────────────────────────────────────────────────

model ServiceFormTemplate {
  id          String   @id @default(uuid())
  orgId       String?
  name        String
  description String?
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User?                      @relation("ServiceFormTemplateCreatedBy", fields: [createdById], references: [id])
  fields      ServiceFormTemplateField[]
  submissions ServiceFormSubmission[]

  @@index([orgId, isActive, createdAt])
  @@index([isActive, createdAt])
  @@map("service_form_templates")
}

model ServiceFormTemplateField {
  id              String               @id @default(uuid())
  templateId      String
  fieldKey        String
  label           String
  fieldType       ServiceFormFieldType
  isRequired      Boolean              @default(true)
  displayOrder    Int                  @default(0)
  validationRules Json?
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  template ServiceFormTemplate          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  values   ServiceFormSubmissionValue[]

  @@unique([templateId, fieldKey])
  @@index([templateId, displayOrder])
  @@map("service_form_template_fields")
}

model ServiceFormSubmission {
  id             String   @id @default(uuid())
  complaintId    String
  templateId     String
  submittedById  String
  testReportId   String?
  isDisabled     Boolean  @default(false)
  disabledReason String?
  submittedAt    DateTime @default(now())

  complaint   ServiceComplaint             @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  template    ServiceFormTemplate          @relation(fields: [templateId], references: [id], onDelete: Restrict)
  submittedBy User                         @relation("ServiceFormSubmittedBy", fields: [submittedById], references: [id])
  testReport  ServiceTestReport?           @relation(fields: [testReportId], references: [id])
  values      ServiceFormSubmissionValue[]

  @@index([complaintId, submittedAt])
  @@index([submittedById, submittedAt])
  @@index([testReportId])
  @@map("service_form_submissions")
}

model ServiceFormSubmissionValue {
  id              String   @id @default(uuid())
  submissionId    String
  fieldId         String
  fieldKey        String
  rawValue        String
  isValid         Boolean
  validationError String?
  createdAt       DateTime @default(now())

  submission ServiceFormSubmission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  field      ServiceFormTemplateField @relation(fields: [fieldId], references: [id], onDelete: Restrict)

  @@unique([submissionId, fieldKey])
  @@index([submissionId])
  @@map("service_form_submission_values")
}

model ServiceMachineClientAudit {
  id              String   @id @default(uuid())
  serviceClientId String
  action          String
  actorId         String?
  meta            Json?
  createdAt       DateTime @default(now())

  client ServiceMachineClient @relation(fields: [serviceClientId], references: [id], onDelete: Cascade)

  @@index([serviceClientId, createdAt])
  @@map("service_machine_client_audit")
}

// Daily SKU demand prediction snapshots.
// One row per (snapshotDate, product, lookbackDays). Upserted by the
// sku-demand-snapshot cron at 02:00 UTC using a rolling window of approved orders.
model SkuDemandSnapshot {
  id                  String   @id @default(uuid())
  snapshotDate        DateTime // midnight UTC on the day this was computed
  productId           String
  sku                 String
  lookbackDays        Int
  orderCount          Int // distinct orders containing this SKU in the window
  totalOrdersInWindow Int // all distinct orders in the window
  totalQtyOrdered     Int // total units of this SKU ordered in the window
  totalAllSkuQty      Int // total units across all SKUs in the window
  orderFrequencyPct   Float // orderCount / totalOrdersInWindow × 100
  volumeSharePct      Float // totalQtyOrdered / totalAllSkuQty × 100
  meanDailyQty        Float // totalQtyOrdered / lookbackDays
  createdAt           DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@unique([snapshotDate, productId, lookbackDays])
  @@index([snapshotDate, lookbackDays])
  @@map("sku_demand_snapshots")
}

// Batch 06 / D-10 / C-16: cross-instance lock for cron jobs.
// Insert a row keyed by (jobName, runKey) — unique violation = lock already held.
// Daily jobs use runKey "YYYY-MM-DD"; per-minute jobs use "YYYY-MM-DDTHH:MM".
// Rows older than 7 days are swept by sweepStaleLocks() (called by field-auto-close).
model CronLock {
  id       String   @id @default(uuid())
  jobName  String
  runKey   String
  lockedAt DateTime @default(now())

  @@unique([jobName, runKey])
  @@index([lockedAt])
  @@map("cron_locks")
}

// =============================================================================
// ACCOUNTS — Double-entry General Ledger (spine of the accounts layer)
// See plan/decisions/accounts.md (DEC-20260712-001) and
// plan/decisions/accounts-market-research.md for the design rationale.
// =============================================================================

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

// What business event produced a journal entry. INVOICE/PAYMENT/PAYMENT_REVERSAL
// are auto-posted from operational flows in Phase 1; the rest land in later phases.
enum JournalSourceType {
  INVOICE
  PAYMENT
  PAYMENT_REVERSAL
  EXCHANGE
  WARRANTY
  SCRAP
  MANUAL
  OPENING
}

// Chart of Accounts — a tree of accounts. `isPostable = false` = a header/group
// node that only aggregates its children. Seeded from a battery-distributor
// template (scripts/seed-chart-of-accounts.ts).
model LedgerAccount {
  id         String       @id @default(uuid())
  code       String       @unique // e.g. "1200" Debtors, "4100" Sales, "2110" GST Output CGST
  name       String
  type       AccountType
  parentId   String?
  isPostable Boolean      @default(true)
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  parent   LedgerAccount?  @relation("AccountTree", fields: [parentId], references: [id])
  children LedgerAccount[] @relation("AccountTree")
  lines    JournalLine[]

  @@index([type])
  @@index([parentId])
  @@map("ledger_accounts")
}

// One balanced accounting event. Immutable once posted — corrections are made
// with a reversing entry (reversalOfId), never by editing. sum(debit)==sum(credit)
// is enforced by the posting engine (backend/src/accounts/posting.ts).
model JournalEntry {
  id           String            @id @default(uuid())
  entryNumber  String            @unique // "JE-2026-000123"
  entryDate    DateTime
  narration    String
  sourceType   JournalSourceType
  sourceId     String? // id of the invoice / outlet_payment / reversal that produced it
  reversalOfId String?           @unique // set when this entry reverses another
  postedById   String? // actor id; scalar (no FK) to avoid a back-relation on User
  createdAt    DateTime          @default(now())

  lines      JournalLine[]
  reversalOf JournalEntry?  @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy JournalEntry?  @relation("Reversal")

  @@index([sourceType, sourceId])
  @@index([entryDate])
  @@map("journal_entries")
}

// A single debit or credit line of a journal entry. One of debit/credit is > 0,
// the other is 0. `outletId` tags party (AR/AP) lines so the GL Debtors balance
// can be reconciled against the per-outlet subledger (accounts.statement).
model JournalLine {
  id        String  @id @default(uuid())
  entryId   String
  accountId String
  debit     Decimal @default(0)
  credit    Decimal @default(0)
  outletId  String?
  memo      String?

  entry   JournalEntry  @relation(fields: [entryId], references: [id])
  account LedgerAccount @relation(fields: [accountId], references: [id])

  @@index([entryId])
  @@index([accountId])
  @@index([outletId])
  @@map("journal_lines")
}

// Per-year monotonic counter for human-readable journal entry numbers.
model JournalSequence {
  year         Int @id
  lastSequence Int @default(0)

  @@map("journal_sequences")
}
